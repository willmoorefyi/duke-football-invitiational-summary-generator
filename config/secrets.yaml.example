# ESPN Authentication Secrets
# Copy this file to secrets.yaml and fill in your ESPN cookie values
# DO NOT commit secrets.yaml to version control!

espn:
  # Get these from your browser's developer tools after logging into ESPN Fantasy
  # Instructions: https://github.com/cwendt94/espn-api#authentication
  
  # ESPN_S2 cookie (long string, ~1000+ characters)
  espn_s2: "YOUR_ESPN_S2_COOKIE_VALUE_HERE"
  
  # SWID cookie (shorter string with curly braces, like {12345678-ABCD-1234-ABCD-123456789ABC})
  swid: "YOUR_SWID_COOKIE_VALUE_HERE"

# Optional: Set your league ID here to avoid specifying it in commands
league:
  league_id: 123456  # Your ESPN Fantasy League ID